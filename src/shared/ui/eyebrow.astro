---
interface Props {
  tone?: 'accent' | 'muted';
}

const { tone = 'accent' } = Astro.props;
---

<p
  class:list={[
    'inline-flex items-center gap-3 text-xs font-bold tracking-widest uppercase before:h-0.5 before:w-6 before:rounded-sm before:bg-current',
    tone === 'accent' ? 'text-accent' : 'text-muted',
  ]}
>
  <slot />
</p>
