---
import { getDictionary } from '../../i18n/dictionary';
import type { Locale } from '../../shared/locale/locales';
import { SECTION_IDS } from '../../shared/site/site-config';
import Eyebrow from '../../shared/ui/eyebrow.astro';
import Section from '../../shared/ui/section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { bio } = getDictionary(locale);
---

<Section id={SECTION_IDS.bio} labelledBy="bio-title" atmosphere="bio">
  <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
    <div class="reveal">
      <div class="mb-3"><Eyebrow>{bio.eyebrow}</Eyebrow></div>
      <h2 id="bio-title" class="mb-8 max-w-[14ch] font-display text-h2 font-bold">{bio.title}</h2>
      {bio.paragraphs.map((paragraph) => <p class="mb-4 max-w-prose text-lg leading-relaxed text-mist/90">{paragraph}</p>)}
    </div>
    <dl class="reveal self-end">
      {
        bio.facts.map((fact) => (
          <div class="grid grid-cols-[7rem_1fr] items-baseline gap-4 border-t border-line py-4 text-sm last:border-b">
            <dt class="text-xs font-semibold tracking-wider text-muted uppercase">{fact.label}</dt>
            <dd class="font-medium">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
