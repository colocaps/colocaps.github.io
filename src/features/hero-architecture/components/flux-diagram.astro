---
import type { Dictionary } from '../../../i18n/dictionary';
import DiagramFrame from './diagram-frame.astro';

interface Props {
  diagram: Dictionary['architecture']['flux']['diagram'];
}

const { diagram } = Astro.props;
---

<DiagramFrame label={diagram.label}>
  <div aria-hidden="true">
    <p class="mb-2 flex justify-between text-xs font-semibold"><span>{diagram.firebase}</span><span class="text-amber">{diagram.firebaseTime}</span></p>
    <div class="h-2.5 w-full rounded-full bg-amber/70"></div>
  </div>
  <div aria-hidden="true">
    <p class="mb-2 flex justify-between text-xs font-semibold"><span>{diagram.flux}</span><span class="text-accent">{diagram.fluxTime}</span></p>
    <div class="h-2.5 w-2 rounded-full bg-accent shadow-node"></div>
  </div>
  <p aria-hidden="true" class="text-xs text-muted">{diagram.reach}</p>
</DiagramFrame>
