---
interface Props {
  href: string;
  year: string;
  name: string;
  role: string;
  tag?: string | undefined;
}

const { href, year, name, role, tag } = Astro.props;
const isHero = tag !== undefined;
---

<li class="w-3/5 shrink-0 snap-start sm:w-2/5 md:w-auto">
  <a
    {href}
    class:list={[
      'group relative block pt-8 pr-6',
      'before:absolute before:top-1.5 before:left-3 before:h-px before:w-full before:bg-accent/40',
      'after:absolute after:top-0 after:left-0 after:size-3 after:rounded-full after:border-2 after:border-accent',
      isHero ? 'after:bg-accent after:shadow-node' : 'after:bg-ink',
    ]}
  >
    <span class="mb-1.5 flex items-center gap-2 text-xs font-bold tracking-wider text-muted">
      {year}
      {tag && <span class="rounded-full bg-accent/15 px-2 py-0.5 text-accent">{tag}</span>}
    </span>
    <span class="mb-1 block font-display text-lg font-bold tracking-tight transition-colors group-hover:text-accent">{name}</span>
    <span class="block text-sm leading-snug text-muted">{role}</span>
  </a>
</li>
