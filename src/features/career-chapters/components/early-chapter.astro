---
import type { Dictionary, EarlyCareerId } from '../../../i18n/dictionary';
import Chip from '../../../shared/ui/chip.astro';
import { chapterId } from '../lib/career-ids';

interface Props {
  id: EarlyCareerId;
  chapter: Dictionary['career']['early'][EarlyCareerId];
}

const { id, chapter } = Astro.props;
---

<article id={chapterId(id)} class="reveal grid gap-4 border-t border-line py-8 md:grid-cols-[16rem_1fr] md:gap-12">
  <header>
    <p class="mb-1 text-xs font-bold tracking-wider text-muted uppercase">{chapter.period}</p>
    <h3 class="font-display text-xl font-bold tracking-tight">{chapter.company}</h3>
    <p class="text-sm text-muted">{chapter.role}</p>
  </header>
  <div>
    {chapter.points.map((point) => <p class="mb-3 max-w-prose leading-relaxed text-mist/90">{point}</p>)}
    <ul class="mt-4 flex flex-wrap gap-2">
      {chapter.tags.map((tag) => <li><Chip>{tag}</Chip></li>)}
    </ul>
  </div>
</article>
