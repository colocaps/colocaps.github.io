---
import { getDictionary } from '../../i18n/dictionary';
import { localePath, type Locale } from '../../shared/locale/locales';
import { SECTION_IDS, sectionHref, siteConfig, type SectionId } from '../../shared/site/site-config';
import { LocaleToggle } from './locale-toggle';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { chrome } = getDictionary(locale);
const navIds = Object.values(SECTION_IDS) as SectionId[];
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/70 backdrop-blur-md">
  <div class="mx-auto flex h-nav w-full max-w-site items-center justify-between gap-6 px-6 md:px-12">
    <a href={localePath(locale)} aria-label={chrome.homeLabel} class="font-display text-lg font-extrabold tracking-tight">
      {siteConfig.handle}<span class="text-accent">.</span>
    </a>
    <nav aria-label={chrome.navLabel} class="hidden lg:block">
      <ul class="flex items-center gap-6 text-sm font-medium text-muted">
        {
          navIds.map((id) => (
            <li>
              <a href={sectionHref(id)} class="transition-colors hover:text-mist">
                {chrome.nav[id]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LocaleToggle client:load current={locale} groupLabel={chrome.localeGroupLabel} labels={chrome.locales} />
  </div>
</header>
